	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#767676", "fontStyle": "italic" }
		},
		{
			"name": "Keywords and storage",
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "variable.language.this", "variable.language.self"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
		},
		{
			"name": "Operators and punctuation",
			"scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.definition.tag", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
			"settings": { "foreground": "#8C8C8C", "fontStyle": "" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.template", "meta.embedded.assembly", "markup.inline.raw"],
			"settings": { "foreground": "#A6A6A6" }
		},
		{
			"name": "String escapes and interpolation",
			"scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded", "constant.other.placeholder"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Regular expressions",
			"scope": ["string.regexp", "constant.regexp"],
			"settings": { "foreground": "#B3B3B3" }
		},
		{
			"name": "Numbers and language constants",
			"scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant", "variable.other.enummember"],
			"settings": { "foreground": "#D9D9D9" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "storage.type.java", "storage.type.cs", "storage.type.primitive", "storage.type.built-in"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "italic" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#D9D9D9" }
		},
		{
			"name": "Decorators and annotations",
			"scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "entity.name.function.macro"],
			"settings": { "foreground": "#B3B3B3", "fontStyle": "italic" }
		},
		{
			"name": "Markup tags",
			"scope": ["entity.name.tag", "support.class.component"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Markup attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#B3B3B3", "fontStyle": "italic" }
		},
		{
			"name": "CSS selectors",
			"scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css", "entity.other.attribute-name.class.scss", "entity.other.attribute-name.class.less"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "" }
		},
		{
			"name": "Property names",
			"scope": ["support.type.property-name", "meta.object-literal.key", "variable.other.property", "variable.other.object.property"],
			"settings": { "foreground": "#E0E0E0", "fontStyle": "" }
		},
		{
			"name": "JSON and YAML keys",
			"scope": ["support.type.property-name.json", "entity.name.tag.yaml"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "" }
		},
		{
			"name": "CSS units",
			"scope": ["keyword.other.unit"],
			"settings": { "foreground": "#8C8C8C", "fontStyle": "" }
		},
		{
			"name": "Headings",
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
		},
		{
			"name": "Bold",
			"scope": "markup.bold",
			"settings": { "fontStyle": "bold" }
		},
		{
			"name": "Italic",
			"scope": "markup.italic",
			"settings": { "fontStyle": "italic" }
		},
		{
			"name": "Strikethrough",
			"scope": "markup.strikethrough",
			"settings": { "fontStyle": "strikethrough" }
		},
		{
			"name": "Links",
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#B3B3B3", "fontStyle": "underline" }
		},
		{
			"name": "Quotes and list markers",
			"scope": ["markup.quote", "punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"],
			"settings": { "foreground": "#8C8C8C" }
		},
		{
			"name": "Diff inserted",
			"scope": "markup.inserted",
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Diff deleted",
			"scope": "markup.deleted",
			"settings": { "foreground": "#767676", "fontStyle": "strikethrough" }
		},
		{
			"name": "Diff changed and headers",
			"scope": ["markup.changed", "meta.diff.header", "meta.diff.range"],
			"settings": { "foreground": "#B3B3B3" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "underline" }
		}
	]
}
